[
  // Weapons (main hand)
  { "id": "wooden_sword", "name": "Wooden Sword", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 1 }, "value": 2, "text": "Weapon 1: adds 1 to one Rumble roll a turn." },
  { "id": "longsword", "name": "Longsword", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 1, "weaponDice": 1 }, "versatile": 1, "value": 14, "text": "Weapon 1 + 1d6 on one Rumble roll a turn (a 6 on its die rolls another straight in). Versatile: +1 more with nothing in your off hand." },
  { "id": "knights_sword", "name": "Knight's Sword", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2 }, "set": { "with": "knights_shield", "modifiers": { "weapon": 1, "block": 1 } }, "value": 10, "text": "Weapon 2: adds 2 to one Rumble roll a turn. Set, with the Knight's Shield: +1 Weapon and Block 1." },
  { "id": "trident", "name": "Trident", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 1 }, "attackRange": 2, "swimmerBonus": 1, "value": 9, "text": "Two-handed. Weapon 1, reaching 2 tiles. +1 more against swimmers, and it spears them even submerged." },
  { "id": "short_bow", "name": "Short Bow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 1 }, "attackRange": 6, "value": 8, "text": "Two-handed. Weapon 1. Attack at range 6." },
  { "id": "great_axe", "name": "Great Axe", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 2, "weaponDice": 1 }, "cleave": true, "value": 18, "text": "Two-handed. Weapon 2 + 1d6 on one Rumble roll a turn (a 6 on its die rolls another straight in). Cleave: each 6 also strikes another monster beside you." },
  { "id": "maul", "name": "Maul", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 3 }, "shoveOnSix": true, "value": 14, "text": "Two-handed. Weapon 3. Any 6 on its attack shoves the target a tile back, hit or miss." },
  { "id": "war_hammer", "name": "War Hammer", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2 }, "crush": true, "value": 12, "text": "Weapon 2. Crushing: a hit knocks a shelled monster onto its back, and bones it breaks stay broken." },
  { "id": "spear", "name": "Spear", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2 }, "attackRange": 2, "reach": true, "value": 8, "text": "Weapon 2. Reach 2 in a straight line, past an ally in front of you." },
  { "id": "dagger", "name": "Dagger", "type": "weapon", "slot": "offHand", "altSlot": "mainHand", "stacks": true, "attackBonus": 1, "offHandStrike": true, "thrownRange": 3, "ambush": true, "light": true, "value": 3, "text": "Either hand. +1, on an attack of its own from the off hand. Doubled against a stunned or prone monster. Thrown at range 3, it lands at the target's feet. One in each hand: +1 more each." },
  { "id": "rapier", "name": "Rapier", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2, "block": 1 }, "twinStrike": true, "value": 14, "text": "Weapon 2. Parry: Block 1. With nothing in your off hand but a Buckler or a Dagger, its bonus goes on two attacks a turn." },
  { "id": "crossbow", "name": "Crossbow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 3 }, "attackRange": 8, "reload": { "odHand": 1 }, "value": 14, "text": "Two-handed. Weapon 3 on every loaded shot, range 8. Each shot unloads it: reloading takes an Od Hand or Rumble die. Loaded on each new floor." },
  { "id": "heavy_crossbow", "name": "Heavy Crossbow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 4 }, "attackRange": 9, "reload": { "odHand": 1, "wend": 1 }, "value": 20, "text": "Two-handed. Weapon 4 on every loaded shot, range 9. Each shot unloads it: reloading takes an Od Hand or Rumble die, and a Wend die. Loaded on each new floor." },
  { "id": "frost_brand", "name": "Frost Brand", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 1, "weaponDice": 1 }, "dieType": "ice", "value": 16, "text": "Weapon 1 + 1 Ice die on one Rumble roll a turn: on a hit each 6 freezes the target a stack." },
  { "id": "quake_hammer", "name": "Quake Hammer", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 2, "weaponDice": 1 }, "dieType": "earth", "value": 18, "text": "Two-handed. Weapon 2 + 1 Earth die on one Rumble roll a turn: on a hit a 6 knocks the target prone, and buries someone already down." },
  { "id": "longbow", "name": "Longbow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 1, "weaponDice": 1 }, "attackRange": 10, "value": 16, "text": "Two-handed. Weapon 1 + 1d6 on one Rumble roll a turn (a 6 on its die rolls another straight in). Attack at range 10." },

  // Shields (off hand)
  { "id": "buckler", "name": "Buckler", "type": "shield", "slot": "offHand", "modifiers": { "armor": 1, "block": 1 }, "light": true, "value": 2, "text": "Armor 1. Block 1: +1 to the first defense that's losing, back each turn." },
  { "id": "tower_shield", "name": "Tower Shield", "type": "shield", "slot": "offHand", "modifiers": { "armor": 3, "block": 3, "speed": -1 }, "value": 10, "text": "Armor 3. Block 3: +3 to the first defense that's losing, back each turn. -1 Wend." },
  { "id": "knights_shield", "name": "Knight's Shield", "type": "shield", "slot": "offHand", "modifiers": { "armor": 2, "defenseDice": 1 }, "set": { "with": "knights_sword", "modifiers": { "guardDice": 1 } }, "value": 10, "text": "Armor 2, and an extra Defense die: it rolls in when a defense is losing, back each turn. Set, with the Knight's Sword: a Guard Die for an ally beside you (a 6 rolls another), once a round." },

  // Armor and boots
  { "id": "leather_cap", "name": "Leather Cap", "type": "armor", "slot": "head", "modifiers": { "hearts": 1 }, "value": 3, "text": "+1 Heart." },
  { "id": "diving_helm", "name": "Diving Helm", "type": "armor", "slot": "head", "modifiers": { "armor": 1 }, "swims": true, "value": 8, "text": "Armor 1. Water costs you 1 step a tile, and you stay afloat in deep water without spending a Rumble die." },
  { "id": "lucky_helmet", "name": "Lucky Helmet", "type": "armor", "slot": "head", "modifiers": { "armor": 1 }, "lastChanceDie": true, "value": 5, "text": "Armor 1. Your last line of defense: when you'd be hit anyway, it rolls one more die in, then breaks." },
  { "id": "cowards_cloak", "name": "Coward's Cloak", "type": "armor", "slot": "head", "altSlot": "accessory", "breaksOnUse": true, "effect": { "kind": "cowardsFlight", "amount": 1 }, "value": 15, "text": "Worn on the head (a hood to hide in) or as an accessory. Use it (once, then it's gone): monsters beside you move at half speed on their next turn, and your Rumble and Od Hand dice left this turn become Wend dice." },
  { "id": "leather_armor", "name": "Leather Armor", "type": "armor", "slot": "body", "modifiers": { "armor": 1 }, "value": 3, "text": "Armor 1: adds 1 to every defense." },
  { "id": "studded_armor", "name": "Studded Armor", "type": "armor", "slot": "body", "modifiers": { "armor": 2 }, "value": 6, "text": "Armor 2: adds 2 to every defense." },
  { "id": "chain_mail", "name": "Chain Mail", "type": "armor", "slot": "body", "modifiers": { "armor": 3 }, "value": 10, "text": "Armor 3: adds 3 to every defense." },
  { "id": "wardens_plate", "name": "Warden's Plate", "type": "armor", "slot": "body", "modifiers": { "armor": 3, "defenseDice": 1 }, "value": 25, "text": "The Iron Warden's own. Armor 3, and an extra Defense die: it rolls in when a defense is losing, back each turn." },
  { "id": "storm_mail", "name": "Storm Mail", "type": "armor", "slot": "body", "modifiers": { "armor": 1 }, "rumbleType": "elektrik", "value": 18, "text": "Armor 1. Your Rumble dice crackle: they're Elektrik dice, earning no Power Dice, but each 6 rolls another in and on a hit stuns." },
  { "id": "dash_boots", "name": "Dash Boots", "type": "boots", "slot": "feet", "modifiers": { "moveDice": 1 }, "value": 10, "text": "+1 Wend die." },

  // Accessories
  { "id": "jackalope_foot", "name": "Lucky Jackalope's Foot", "type": "accessory", "slot": "accessory", "modifiers": { "luck": 1 }, "value": 8, "text": "+1 Luck: reroll one more die a floor." },
  { "id": "shield_cufflinks", "name": "Shield Cufflinks", "type": "accessory", "slot": "accessory", "modifiers": { "armor": 1, "block": 1 }, "value": 10, "text": "Armor 1. Block 1: +1 to the first defense that's losing, back each turn." },
  { "id": "icarus_wings", "name": "Icarus Wings", "type": "accessory", "slot": "accessory", "wings": true, "value": 20, "text": "Beat them for a d6 of flight, over pits, water and traps, and again as often as you dare; a 6 rolls a Power Die in. A 1 breaks them: you drop where you are, prone and stunned, your Wend gone for the turn." },

  // Spells and tools
  { "id": "flame_scroll", "name": "Flame Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "flame_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "fire" }, "value": 4, "text": "Single use. Hurl fire up to 3 tiles: 3 Fire dice at whoever is there (not your Rumble dice). Each 6 rolls another Fire die in and, on a hit, sets them alight. Aimed at bare floor, it sets it burning for 3 rounds: anyone on it or walking through catches fire. Or learn it as Flame Blast: Od Hand and Magic, 9 or more." },
  { "id": "frost_scroll", "name": "Frost Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "frost_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "ice" }, "value": 4, "text": "Single use. 3 Ice dice at whoever is within 3. On a hit each 6 freezes them a stack: slowed, then their Wend dice taken, then frozen solid. Or learn it as Frost Blast: Od Hand and Magic, 9 or more." },
  { "id": "venom_scroll", "name": "Venom Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "venom_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "poison" }, "value": 4, "text": "Single use. 3 Poison dice at whoever is within 3. On a hit each 6 poisons them: -1 to all their rolls, and a heart lost when they can't roll past their poison. Or learn it as Venom Blast: Od Hand and Magic, 9 or more." },
  { "id": "acid_scroll", "name": "Acid Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "acid_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "acid" }, "value": 4, "text": "Single use. 3 Acid dice at whoever is within 3. On a hit each 6 eats a point of armor, or with none left, burns them again at the end of their turn. Or learn it as Acid Blast: Od Hand and Magic, 9 or more." },
  { "id": "grave_scroll", "name": "Grave Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "grave_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "necro" }, "value": 6, "text": "Single use. 3 Necro dice at whoever is within 3. On a hit each 6 blackens a lost heart, which can't be healed; a kill with one rises as your zombie. Or learn it as Grave Blast: Od Hand and Magic, 9 or more." },
  { "id": "gale_scroll", "name": "Gale Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "gale_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "squall" }, "value": 4, "text": "Single use. 3 Squall dice at whoever is within 3. On a hit each 6 blows them a tile away; slammed into something, they take a die for every tile. Or learn it as Gale Blast: Od Hand and Magic, 9 or more." },
  { "id": "sun_scroll", "name": "Sun Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "sun_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "radiate" }, "value": 4, "text": "Single use. 3 Radiate dice at whoever is within 3. On a hit each 6 makes them shine: -1 to their defense, fading a turn at a time. Or learn it as Sun Blast: Od Hand and Magic, 9 or more." },
  { "id": "bloom_scroll", "name": "Bloom Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "bloom_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "life" }, "value": 5, "text": "Single use. 3 Life dice at whoever is within 3. On a hit each 6 grows plants under them, rough going for your foes and cover for your side; where plants grow already, a Sentient Shrub springs up to fight for you. Or learn it as Bloom Blast: Od Hand and Magic, 9 or more." },
  { "id": "quake_scroll", "name": "Quake Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "quake_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "earth" }, "value": 4, "text": "Single use. 3 Earth dice at whoever is within 3. On a hit a 6 knocks them prone, and each more buries them: 3 Rumble to dig out of each. Or learn it as Quake Blast: Od Hand and Magic, 9 or more." },
  { "id": "spark_scroll", "name": "Spark Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "spark_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "elektrik" }, "value": 4, "text": "Single use. 3 Elektrik dice at whoever is within 3. On a hit each 6 stuns them. Or learn it as Spark Blast: Od Hand and Magic, 9 or more." },
  { "id": "mind_scroll", "name": "Mind Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "mind_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "psycho" }, "value": 5, "text": "Single use. 3 Psycho dice at whoever is within 3. On a hit each 6 confuses them a turn: they lash out at whoever is beside them and stagger off. Or learn it as Mind Blast: Od Hand and Magic, 9 or more." },
  { "id": "shadow_scroll", "name": "Shadow Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "teaches": "shadow_blast", "effect": { "kind": "attack", "amount": 3, "range": 3, "dieType": "shadow" }, "value": 4, "text": "Single use. 3 Shadow dice at whoever is within 3. On a hit each 6 blinds them: -1 to their attacks, and nothing past the tiles beside them, until cured. Or learn it as Shadow Blast: Od Hand and Magic, 9 or more." },
  { "id": "frost_wand", "name": "Frost Wand", "type": "spell", "slot": "offHand", "usage": "charges", "charges": 2, "effect": { "kind": "attack", "amount": 2, "range": 3, "dieType": "ice", "chill": 1 }, "value": 8, "text": "2 charges per floor. A monster within 3 is frozen a stack, then attacked with 2 Ice dice: on a hit each 6 freezes it a stack more." },
  { "id": "boomerang", "name": "Boomerang", "type": "weapon", "slot": "offHand", "altSlot": "mainHand", "attackRange": 4, "attackBonus": 1, "stunOnSix": true, "value": 6, "text": "Off hand or main hand. Throw it with your Rumble dice +1 at a target within 4; on a hit, every 6 stuns it." },
  { "id": "torch", "name": "Torch", "type": "tool", "slot": "offHand", "altSlot": "mainHand", "stacks": true, "torch": true, "belts": true, "value": 1, "text": "Stacks in one slot; one to a hand. It can ride on your belt, but only held is it lit: +1d6 on Search rolls, it lights your way, and a fire die on your Rumble attacks. A 6 on the fire die rolls another, and on a hit sets the target alight. Any 1 in the attack burns the torch out." },
  { "id": "lockpicks", "name": "Lockpicks", "type": "tool", "slot": "offHand", "stacks": true, "belts": true, "tool": { "for": "pickLock", "bonus": 1, "dice": 1, "snaps": true }, "value": 6, "text": "Stacks; rides on your belt, and works from there or a hand. +1 and 1d6 on one lock-picking roll a turn (doors, chests, gates; a 6 on its die rolls another straight in). A failed pick with a 1 showing snaps one." },

  // Consumables
  { "id": "bomb", "name": "Bomb", "type": "bomb", "usage": "singleUse", "stacks": true, "effect": { "kind": "attack", "amount": 4, "range": 3, "areaRadius": 1 }, "value": 1, "text": "Single use. Throw it up to 3 tiles, lit: at the end of your next turn it blasts everyone within a tile (yourself too) with 4 dice. More dice through means a shove, knocked flat, stunned. Breaks cracked walls." },
  { "id": "autosmith_hammer", "name": "Autosmith Hammer", "type": "tool", "usage": "singleUse", "stacks": true, "effect": { "kind": "repair" }, "value": 4, "text": "Single use. Mends your most worn gear (armor acid ate) good as new, anywhere." },
  { "id": "eye_drops", "name": "Eye Drops", "type": "potion", "usage": "singleUse", "stacks": true, "effect": { "kind": "cure", "cures": "blind" }, "value": 3, "text": "Single use. Clears blind eyes." },
  { "id": "holy_water", "name": "Holy Water", "type": "potion", "usage": "singleUse", "stacks": true, "effect": { "kind": "holy", "cures": "blackHeart", "range": 3, "amount": 5 }, "value": 6, "text": "Single use. Drink it to cure disease and curses: your Black Hearts can heal again. Or throw it at the undead within 3: lesser undead (Skeletons, the Drowned, zombies) are destroyed outright, bones and all; greater undead (Ghouls, fallen heroes risen) take 5 Radiate dice." },
  { "id": "antidote", "name": "Antidote", "type": "potion", "usage": "singleUse", "stacks": true, "effect": { "kind": "cure", "cures": "poison" }, "value": 3, "text": "Single use. Cures poison." },
  { "id": "strong_base", "name": "Strong Base", "type": "potion", "usage": "singleUse", "stacks": true, "effect": { "kind": "cure", "cures": "acid" }, "value": 3, "text": "Single use. Washes the acid off you before it burns again (it doesn't mend gear the acid wore)." },
  { "id": "smelling_salts", "name": "Smelling Salts", "type": "potion", "usage": "singleUse", "stacks": true, "effect": { "kind": "cure", "cures": "confused" }, "value": 3, "text": "Single use. Clears a confused head." },
  { "id": "bandages", "name": "Bandages", "type": "tool", "usage": "singleUse", "stacks": true, "bandage": true, "value": 2, "text": "Single use, stacks. Carried, one goes into each Aid that rouses an ally Keeling Over: +1d6 (a 6 rolls another)." },
  { "id": "burgling_tools", "name": "Burgling Tools", "type": "tool", "slot": "offHand", "tool": { "for": "pickLock, disarm, steal", "bonus": 1, "dice": 1, "snaps": true }, "value": 16, "text": "Off hand. +1 and 1d6 on one roll a turn to pick a lock, disarm a trap or steal (a 6 on its die rolls another). Without the skill, they do it alone. A failed roll with a 1 showing breaks them." },
  { "id": "cutpurse_knife", "name": "Cutpurse Knife", "type": "weapon", "slot": "offHand", "altSlot": "mainHand", "attackBonus": 1, "offHandStrike": true, "light": true, "tool": { "for": "steal", "bonus": 1, "dice": 1 }, "value": 10, "text": "Either hand. Weapon 1 (from the off hand, on an attack of its own). +1 and 1d6 on one steal a turn; without the skill, it steals alone." },
  { "id": "sticky_gloves", "name": "Sticky Gloves", "type": "accessory", "slot": "accessory", "tool": { "for": "steal", "bonus": 1, "dice": 1 }, "value": 10, "text": "+1 and 1d6 on one steal a turn (a 6 on its die rolls another); without the skill, they steal alone." },
  { "id": "medicine_bag", "name": "Medicine Bag", "type": "tool", "slot": "offHand", "stacks": true, "belts": true, "medicineBag": true, "value": 8, "text": "Stacks; rides on your belt, and works from there or a hand. +1 and 1d6 on one Aid roll a turn (a 6 rolls another), even with no Od Hand dice left; with it, Aid cures Freeze, Black Hearts, Burning and Stun too. A failed Aid with a 1 showing uses one up." },
  { "id": "shovel", "name": "Shovel", "type": "weapon", "slot": "mainHand", "twoHanded": true, "shovel": true, "modifiers": { "weapon": 2 }, "value": 5, "text": "Two-handed. Weapon 2, and a die more and +1 against earth creatures. Held, it digs a stack of earth off you at the start of your turn, and adds a die to digging out and to Aid against Buried." },
  { "id": "sineater_doll", "name": "Sineater Doll", "type": "tool", "usage": "singleUse", "sinEater": true, "effect": { "kind": "sinEater", "range": 3, "areaRadius": 1 }, "value": 20, "text": "Very rare. Soak what ails you or an ally beside you into it, no roll: up to 10 stacks of anything. Then throw it up to 3 tiles: it bursts where it lands, laying every stack on everyone within a tile, friend or foe, no save, and is gone." },
  { "id": "health_potion", "name": "Health Potion", "type": "potion", "usage": "singleUse", "stacks": true, "effect": { "kind": "heal", "amount": 3 }, "value": 2, "text": "Single use. Restore 3 hearts." },

  // Treasure
  { "id": "loose_coins", "name": "Loose Coins", "type": "treasure", "coins": true, "value": 2, "text": "2 gold, straight into your purse. Found in pots." },
  { "id": "coin_pouch", "name": "Coin Pouch", "type": "treasure", "coins": true, "value": 5, "text": "5 gold, straight into your purse." },
  { "id": "emerald", "name": "Emerald", "type": "treasure", "value": 15, "text": "Worth 15 gold." },
  { "id": "pearl", "name": "Pearl", "type": "treasure", "value": 20, "text": "Worth 20 gold." },
  { "id": "golden_idol", "name": "Golden Idol", "type": "treasure", "value": 40, "text": "Worth 40 gold." }
]
