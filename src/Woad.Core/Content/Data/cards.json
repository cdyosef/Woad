[
  // Weapons (main hand)
  { "id": "wooden_sword", "name": "Wooden Sword", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 1 }, "value": 2, "text": "Weapon 1: adds 1 to one Rumble roll a turn." },
  { "id": "longsword", "name": "Longsword", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 1, "weaponDice": 1 }, "versatile": 1, "value": 14, "text": "Weapon 1 + 1d6 on one Rumble roll a turn (a 6 on its die rolls another straight in). Versatile: +1 more with nothing in your off hand." },
  { "id": "knights_sword", "name": "Knight's Sword", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2 }, "set": { "with": "knights_shield", "modifiers": { "weapon": 1, "block": 1 } }, "value": 10, "text": "Weapon 2: adds 2 to one Rumble roll a turn. Set, with the Knight's Shield: +1 Weapon and Block 1." },
  { "id": "trident", "name": "Trident", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 1 }, "attackRange": 2, "swimmerBonus": 1, "value": 9, "text": "Two-handed. Weapon 1, reaching 2 tiles. +1 more against swimmers, and it spears them even submerged." },
  { "id": "short_bow", "name": "Short Bow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 1 }, "attackRange": 6, "value": 8, "text": "Two-handed. Weapon 1. Attack at range 6." },
  { "id": "great_axe", "name": "Great Axe", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 2, "weaponDice": 1 }, "cleave": true, "value": 18, "text": "Two-handed. Weapon 2 + 1d6 on one Rumble roll a turn (a 6 on its die rolls another straight in). Cleave: each 6 also strikes another monster beside you." },
  { "id": "maul", "name": "Maul", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 3 }, "shoveOnSix": true, "value": 14, "text": "Two-handed. Weapon 3. Any 6 on its attack shoves the target a tile back, hit or miss." },
  { "id": "war_hammer", "name": "War Hammer", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2 }, "crush": true, "value": 12, "text": "Weapon 2. Crushing: a hit knocks a shelled monster onto its back, and bones it breaks stay broken." },
  { "id": "spear", "name": "Spear", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2 }, "attackRange": 2, "reach": true, "value": 8, "text": "Weapon 2. Reach 2 in a straight line, past an ally in front of you." },
  { "id": "dagger", "name": "Dagger", "type": "weapon", "slot": "offHand", "altSlot": "mainHand", "stacks": true, "attackBonus": 1, "offHandStrike": true, "thrownRange": 3, "ambush": true, "light": true, "value": 3, "text": "Either hand. +1, on an attack of its own from the off hand. Doubled against a stunned or prone monster. Thrown at range 3, it lands at the target's feet. One in each hand: +1 more each." },
  { "id": "rapier", "name": "Rapier", "type": "weapon", "slot": "mainHand", "modifiers": { "weapon": 2, "block": 1 }, "twinStrike": true, "value": 14, "text": "Weapon 2. Parry: Block 1. With nothing in your off hand but a Buckler or a Dagger, its bonus goes on two attacks a turn." },
  { "id": "crossbow", "name": "Crossbow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 3 }, "attackRange": 8, "reload": { "odHand": 1 }, "value": 14, "text": "Two-handed. Weapon 3 on every loaded shot, range 8. Each shot unloads it: reloading takes an Od Hand die. Loaded on each new floor." },
  { "id": "heavy_crossbow", "name": "Heavy Crossbow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 4 }, "attackRange": 9, "reload": { "odHand": 1, "wend": 1 }, "value": 20, "text": "Two-handed. Weapon 4 on every loaded shot, range 9. Each shot unloads it: reloading takes an Od Hand die and a Wend die. Loaded on each new floor." },
  { "id": "longbow", "name": "Longbow", "type": "weapon", "slot": "mainHand", "twoHanded": true, "modifiers": { "weapon": 1, "weaponDice": 1 }, "attackRange": 10, "value": 16, "text": "Two-handed. Weapon 1 + 1d6 on one Rumble roll a turn (a 6 on its die rolls another straight in). Attack at range 10." },

  // Shields (off hand)
  { "id": "buckler", "name": "Buckler", "type": "shield", "slot": "offHand", "modifiers": { "armor": 1, "block": 1 }, "light": true, "value": 2, "text": "Armor 1. Block 1: +1 to the first defense that's losing, back each turn." },
  { "id": "tower_shield", "name": "Tower Shield", "type": "shield", "slot": "offHand", "modifiers": { "armor": 3, "block": 3, "speed": -1 }, "value": 10, "text": "Armor 3. Block 3: +3 to the first defense that's losing, back each turn. -1 Wend." },
  { "id": "knights_shield", "name": "Knight's Shield", "type": "shield", "slot": "offHand", "modifiers": { "armor": 2, "defenseDice": 1 }, "set": { "with": "knights_sword", "modifiers": { "guardDice": 1 } }, "value": 10, "text": "Armor 2, and an extra Defense die: it rolls in when a defense is losing, back each turn. Set, with the Knight's Sword: a Guard Die for an ally beside you (a 6 rolls another), once a round." },

  // Armor and boots
  { "id": "leather_cap", "name": "Leather Cap", "type": "armor", "slot": "head", "modifiers": { "hearts": 1 }, "value": 3, "text": "+1 Heart." },
  { "id": "diving_helm", "name": "Diving Helm", "type": "armor", "slot": "head", "modifiers": { "armor": 1 }, "swims": true, "value": 8, "text": "Armor 1. Water costs you 1 step a tile, and you stay afloat in deep water without spending a Rumble die." },
  { "id": "lucky_helmet", "name": "Lucky Helmet", "type": "armor", "slot": "head", "modifiers": { "armor": 1 }, "lastChanceDie": true, "value": 5, "text": "Armor 1. Your last line of defense: when you'd be hit anyway, it rolls one more die in, then breaks." },
  { "id": "cowards_cloak", "name": "Coward's Cloak", "type": "armor", "slot": "head", "breaksOnUse": true, "effect": { "kind": "cowardsFlight", "amount": 1 }, "value": 15, "text": "Worn on the head, a hood to hide in. Use it (once, then it's gone): monsters beside you move at half speed on their next turn, and your Rumble and Od Hand dice left this turn become Wend dice." },
  { "id": "leather_armor", "name": "Leather Armor", "type": "armor", "slot": "body", "modifiers": { "armor": 1 }, "value": 3, "text": "Armor 1: adds 1 to every defense." },
  { "id": "studded_armor", "name": "Studded Armor", "type": "armor", "slot": "body", "modifiers": { "armor": 2 }, "value": 6, "text": "Armor 2: adds 2 to every defense." },
  { "id": "chain_mail", "name": "Chain Mail", "type": "armor", "slot": "body", "modifiers": { "armor": 3 }, "value": 10, "text": "Armor 3: adds 3 to every defense." },
  { "id": "wardens_plate", "name": "Warden's Plate", "type": "armor", "slot": "body", "modifiers": { "armor": 3, "defenseDice": 1 }, "value": 25, "text": "The Iron Warden's own. Armor 3, and an extra Defense die: it rolls in when a defense is losing, back each turn." },
  { "id": "dash_boots", "name": "Dash Boots", "type": "boots", "slot": "feet", "modifiers": { "moveDice": 1 }, "value": 10, "text": "+1 Wend die." },

  // Spells and tools
  { "id": "flame_scroll", "name": "Flame Scroll", "type": "spell", "usage": "singleUse", "stacks": true, "effect": { "kind": "attack", "amount": 3, "range": 3, "fire": true }, "value": 4, "text": "Single use. A 3-dice fire attack on a monster within 3 (not your Rumble dice). Any 6 sets it alight." },
  { "id": "frost_wand", "name": "Frost Wand", "type": "spell", "slot": "offHand", "usage": "charges", "charges": 2, "effect": { "kind": "freeze", "amount": 1, "range": 3 }, "value": 8, "text": "2 charges per floor. Freeze a monster within 3: it skips its next turn." },
  { "id": "boomerang", "name": "Boomerang", "type": "weapon", "slot": "offHand", "altSlot": "mainHand", "attackRange": 4, "attackBonus": 1, "stunOnSix": true, "value": 6, "text": "Off hand or main hand. Throw it with your Rumble dice +1 at a target within 4; every 6 stuns it (hit or miss)." },
  { "id": "lockpicks", "name": "Lockpicks", "type": "tool", "slot": "offHand", "stacks": true, "modifiers": { "tools": 1, "toolDice": 1 }, "value": 6, "text": "Stacks. +1 and 1d6 on one lock-picking roll a turn (doors, chests, gates; a 6 on its die rolls another straight in). A failed pick with a 1 showing snaps one." },

  // Consumables
  { "id": "bomb", "name": "Bomb", "type": "bomb", "usage": "singleUse", "stacks": true, "effect": { "kind": "attack", "amount": 4, "range": 3, "areaRadius": 1 }, "value": 1, "text": "Single use. Throw it up to 3 tiles, lit: at the end of your next turn it blasts everyone within a tile (yourself too) with 4 dice. More dice through means a shove, knocked flat, stunned. Breaks cracked walls." },
  { "id": "health_potion", "name": "Health Potion", "type": "potion", "usage": "singleUse", "stacks": true, "effect": { "kind": "heal", "amount": 3 }, "value": 2, "text": "Single use. Restore 3 hearts." },

