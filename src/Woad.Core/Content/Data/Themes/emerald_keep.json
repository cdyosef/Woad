    { "card": "war_hammer", "minFloor": 2 },
    { "card": "rapier", "minFloor": 2 },
    { "card": "crossbow", "minFloor": 2 },
    { "card": "maul", "minFloor": 2 },
    { "card": "great_axe", "minFloor": 3 },
    { "card": "heavy_crossbow", "minFloor": 3 },
    { "card": "tower_shield", "minFloor": 2 },
