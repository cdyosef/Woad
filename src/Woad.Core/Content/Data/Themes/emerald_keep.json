  // Smashing a pot: 35% loose coins, 25% a heart, otherwise nothing.
  "pots": { "treasure": "loose_coins", "treasureChance": 35, "heartChance": 25 },

  // Legend: . floor  # wall  ~ pit  C chest  P pot  > stairs down  * exit  : rubble (2 steps)
  //         , shallow water (2 steps)  = deep water (swim, 2 steps; monsters can't enter)
  //         1-4 hero starts  M monster spawn point  & boss (in a vault: the miniboss)
  // Roles: arrival, combat, treasure (also used for secret rooms), stairs, boss, vault (the last floor's
  // Boss Key chest and its guard). Stairs up ('<') are added to lower floors' arrival rooms.
  // Doorway tiles (middle of each edge) must stay '.'. Rooms are rotated and mirrored when used.
  "rooms": [
    {
      "id": "gatehouse",
      "roles": ["arrival"],
      "layout": [
        "##.....##",
        "#P.....P#",
        ".........",
