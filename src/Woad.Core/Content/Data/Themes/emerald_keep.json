{
  "id": "emerald_keep",
  "name": "The Emerald Keep",
  "floors": 3,
  "boss": "iron_warden",

  "roster": [
    { "monster": "slime", "weight": 3 },
    { "monster": "bat", "weight": 2 },
    { "monster": "spear_guard", "weight": 2 },
    { "monster": "archer_guard", "weight": 2, "minFloor": 2 },
    { "monster": "skeleton", "weight": 2, "minFloor": 2 }
  ],

  // Chests and monster drops deal from this deck; minFloor keeps the best cards for deeper floors.
  "lootDeck": [
    { "card": "health_potion", "copies": 4 },
    { "card": "bomb", "copies": 3 },
    { "card": "flame_scroll", "copies": 2 },
    { "card": "boomerang" },
    { "card": "lockpicks", "copies": 2 },
    { "card": "leather_cap", "copies": 2 },
    { "card": "coin_pouch", "copies": 6 },
    { "card": "frost_wand", "minFloor": 2 },
    { "card": "knights_sword", "minFloor": 2 },
    { "card": "short_bow", "minFloor": 2 },
    { "card": "tower_shield", "minFloor": 2 },
    { "card": "chain_mail", "minFloor": 2 },
    { "card": "dash_boots", "minFloor": 2 },
    { "card": "emerald", "copies": 3, "minFloor": 2 },
    { "card": "golden_idol", "minFloor": 3 }
  ],

  // Smashing a pot: 35% loose coins, 25% a heart, otherwise nothing.
  "pots": { "treasure": "loose_coins", "treasureChance": 35, "heartChance": 25 },

